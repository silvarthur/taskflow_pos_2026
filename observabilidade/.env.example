# Template das variaveis da stack de observabilidade.
#
#   cp observabilidade/.env.example observabilidade/.env
#
# O arquivo ".env" real NUNCA deve ser commitado (ja esta no .gitignore).
# Escolha uma senha propria; nao reutilize senhas de servicos reais.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-forte-aqui
